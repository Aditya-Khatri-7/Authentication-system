PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/auth-system

# Email SMTP Settings (Optional for production emails; console fallback used if blank)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password
EMAIL_FROM="Enterprise Auth Service" <noreply@auth.local>
